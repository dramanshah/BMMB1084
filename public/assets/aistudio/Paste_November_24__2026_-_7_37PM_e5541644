let currentTab = 'm1';
let allSchemesOpen = false;
let state = JSON.parse(localStorage.getItem('bmmb1084_sim_state') || '{}');
if (!state.answers) state.answers = {};
if (!state.scores) state.scores = {};
if (!state.mcq) state.mcq = {};

function saveState() {
  localStorage.setItem('bmmb1084_sim_state', JSON.stringify(state));
  updateStats();
}

function switchTab(tab, btn) {
  currentTab = tab;
  allSchemesOpen = false;
  document.getElementById('toggleAllBtn').textContent = '👁️ Papar Semua Skema';
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  render();
  updateStats();
}

function render() {
  const container = document.getElementById('appContent');
  if (currentTab === 'mcq') {
    document.getElementById('toggleAllBtn').style.display = 'none';
    renderMCQ(container);
    return;
  }
  document.getElementById('toggleAllBtn').style.display = 'inline-flex';
  const mod = MODULES[currentTab];
  let html = `
    <div class="exam-header-box">
      <div style="font-weight:700; color:var(--primary); font-size:1.05rem;">${mod.title.toUpperCase()} — PEPERIKSAAN AKHIR BMMB1084</div>
      <div class="exam-meta">
        <span>⏱️ Masa: 2 Jam</span>
        <span>📊 Jumlah Markah: 70 Markah</span>
        <span>📚 Rujukan: <em>Tatabahasa Dewan Edisi Keempat</em></span>
      </div>
    </div>

    <div class="section-title">
      <span>BAHAGIAN A: SOALAN STRUKTUR (Jawab semua soalan)</span>
      <span>30 Markah</span>
    </div>
  `;

  mod.bahagianA.forEach(q => {
    html += `<div class="q-card">
      <div class="q-header">
        <span class="q-num">${q.num}</span>
        <span class="q-marks">15 Markah</span>
      </div>
      <div class="stimulus">${q.stimulus}</div>
    `;
    q.sub.forEach(sq => {
      html += renderEssayBlock(sq.id, sq.label, sq.marks, sq.prompt, sq.keywords, sq.scheme);
    });
    html += `</div>`;
  });

  html += `
    <div class="section-title">
      <span>BAHAGIAN B: SOALAN ESEI (Pilih dan jawab DUA soalan sahaja)</span>
      <span>40 Markah</span>
    </div>
    <div class="choice-banner">ℹ️ Arahan Calon IPGM: Bahagian B mengandungi 3 soalan. Anda hanya perlu menilai markah bagi <strong>2 soalan terbaik</strong> (maksimum 40 markah).</div>
  `;

  mod.bahagianB.forEach(q => {
    html += `<div class="q-card">
      <div class="q-header">
        <span class="q-num">${q.num}</span>
        <span class="q-marks">${q.marks} Markah</span>
      </div>
      <div class="stimulus">${q.stimulus}</div>
      ${renderEssayBlock(q.id, q.num, q.marks, q.prompt, q.keywords, q.scheme)}
    </div>`;
  });

  container.innerHTML = html;
}

function renderEssayBlock(id, label, maxMarks, prompt, keywords, scheme) {
  const savedAns = state.answers[id] || '';
  const savedScore = state.scores[id];
  const bands = [
    { name: "Amat Cemerlang", pct: 0.95 },
    { name: "Cemerlang", pct: 0.82 },
    { name: "Kepujian", pct: 0.68 },
    { name: "Lulus", pct: 0.54 },
    { name: "Lemah", pct: 0.30 }
  ];

  return `
    <div style="margin-top:0.85rem; padding-top:0.75rem; border-top:1px solid #f1f5f9;">
      <div class="q-prompt">${label}. ${prompt} <span style="color:var(--muted); font-weight:600;">(${maxMarks} markah)</span></div>
      <textarea id="ta_${id}" placeholder="Taip jawapan analisis sintaksis anda di sini berpandukan Tatabahasa Dewan Edisi Keempat..." oninput="onAnswerInput('${id}', ${JSON.stringify(keywords).replace(/"/g, '&quot;')})">${savedAns}</textarea>
      <div class="q-controls">
        <div class="kw-bar" id="kw_${id}">
          <span style="color:var(--muted); font-weight:600;">Kata Kunci:</span>
          ${keywords.map(k => `<span class="kw-pill ${savedAns.toLowerCase().includes(k.toLowerCase()) ? 'hit' : ''}">${k}</span>`).join('')}
        </div>
        <button class="action-btn" onclick="toggleScheme('${id}')">📖 Semak Skema &amp; Rubrik</button>
      </div>
      <div class="scheme-box ${allSchemesOpen ? 'open' : ''}" id="sc_${id}">
        <div class="scheme-title">
          <span>Cadangan Jawapan Skema Pemarkahan (Tatabahasa Dewan Edisi Keempat)</span>
          <span>Maksimum: ${maxMarks}M</span>
        </div>
        <div>${scheme}</div>
        <div class="rubric-selector">
          <span style="font-size:0.8rem; font-weight:700; color:var(--accent);">Penilaian Kendiri Rubrik:</span>
          ${bands.map(b => {
            const val = +(maxMarks * b.pct).toFixed(1);
            const sel = savedScore === val ? 'selected' : '';
            return `<button class="band-btn ${sel}" onclick="setBandScore('${id}', ${val}, this)">${b.name} (${val}M)</button>`;
          }).join('')}
        </div>
      </div>
    </div>
  `;
}

function onAnswerInput(id, keywords) {
  const val = document.getElementById('ta_' + id).value;
  state.answers[id] = val;
  const kwBar = document.getElementById('kw_' + id);
  kwBar.innerHTML = `<span style="color:var(--muted); font-weight:600;">Kata Kunci:</span>` +
    keywords.map(k => `<span class="kw-pill ${val.toLowerCase().includes(k.toLowerCase()) ? 'hit' : ''}">${k}</span>`).join('');
  saveState();
}

function toggleScheme(id) {
  document.getElementById('sc_' + id).classList.toggle('open');
}

function toggleAllSchemes() {
  allSchemesOpen = !allSchemesOpen;
  document.getElementById('toggleAllBtn').textContent = allSchemesOpen ? '🙈 Sembunyikan Semua Skema' : '👁️ Papar Semua Skema';
  document.querySelectorAll('.scheme-box').forEach(el => {
    if (allSchemesOpen) el.classList.add('open');
    else el.classList.remove('open');
  });
}

function setBandScore(id, val, btn) {
  state.scores[id] = val;
  btn.parentElement.querySelectorAll('.band-btn').forEach(b => b.classList.remove('selected'));
  btn.classList.add('selected');
  saveState();
}

function renderMCQ(container) {
  let html = `
    <div class="section-title">
      <span>LATIH TUBI OBJEKTIF PANTAS: ASAS SINTAKSIS (BMMB1084)</span>
      <span>25 Soalan</span>
    </div>
  `;
  MCQ_DATA.forEach((item, idx) => {
    const chosen = state.mcq[idx];
    html += `<div class="q-card">
      <div class="q-header">
        <span class="q-num">Soalan ${idx + 1}</span>
        <span class="q-marks">1 Markah</span>
      </div>
      <div class="q-prompt">${item.q}</div>
      <div>
        ${item.opts.map((opt, oIdx) => {
          let cls = 'mcq-opt';
          if (chosen !== undefined) {
            if (oIdx === item.ans) cls += ' correct';
            else if (oIdx === chosen) cls += ' wrong';
          }
          return `<div class="${cls}" onclick="pickMCQ(${idx}, ${oIdx})"><strong>${String.fromCharCode(65 + oIdx)}.</strong> ${opt}</div>`;
        }).join('')}
      </div>
      <div class="mcq-rationale ${chosen !== undefined ? 'show' : ''}">
        <strong>Ulasan Tatabahasa Dewan:</strong> ${item.exp}
      </div>
    </div>`;
  });
  container.innerHTML = html;
}

function pickMCQ(qIdx, oIdx) {
  if (state.mcq[qIdx] !== undefined) return;
  state.mcq[qIdx] = oIdx;
  saveState();
  renderMCQ(document.getElementById('appContent'));
}

function updateStats() {
  if (currentTab === 'mcq') {
    document.getElementById('statMode').textContent = '25 Soalan Objektif';
    let right = 0, answered = 0;
    MCQ_DATA.forEach((m, i) => {
      if (state.mcq[i] !== undefined) {
        answered++;
        if (state.mcq[i] === m.ans) right++;
      }
    });
    document.getElementById('statScore').textContent = `${right} / 25 Betul`;
    const pct = answered ? Math.round((right / 25) * 100) : 0;
    document.getElementById('statGrade').textContent = answered === 0 ? 'Belum Dijawab' : `${pct}% (${getGrade(pct)})`;
    return;
  }

  const mod = MODULES[currentTab];
  document.getElementById('statMode').textContent = mod.title;
  let totalA = 0;
  mod.bahagianA.forEach(q => q.sub.forEach(sq => { totalA += (state.scores[sq.id] || 0); }));
  let bScores = mod.bahagianB.map(q => state.scores[q.id] || 0).sort((a, b) => b - a);
  let totalB = (bScores[0] || 0) + (bScores[1] || 0); // 2 soalan terbaik
  let grand = +(totalA + totalB).toFixed(1);
  document.getElementById('statScore').textContent = `${grand} / 70`;
  const pct = Math.round((grand / 70) * 100);
  document.getElementById('statGrade').textContent = grand === 0 ? 'Belum Dinilai' : `${pct}% (${getGrade(pct)})`;
}

function getGrade(pct) {
  if (pct >= 90) return 'A+ (Amat Cemerlang)';
  if (pct >= 80) return 'A (Cemerlang)';
  if (pct >= 75) return 'A- (Cemerlang)';
  if (pct >= 70) return 'B+ (Kepujian)';
  if (pct >= 65) return 'B (Kepujian)';
  if (pct >= 60) return 'B- (Kepujian)';
  if (pct >= 50) return 'C (Lulus)';
  return 'Perlu Pemulihan';
}

function resetCurrentModule() {
  if (!confirm('Adakah anda pasti mahu memadam jawapan dan markah bagi modul semasa?')) return;
  if (currentTab === 'mcq') {
    state.mcq = {};
  } else {
    const mod = MODULES[currentTab];
    mod.bahagianA.forEach(q => q.sub.forEach(sq => { delete state.answers[sq.id]; delete state.scores[sq.id]; }));
    mod.bahagianB.forEach(q => { delete state.answers[q.id]; delete state.scores[q.id]; });
  }
  saveState();
  render();
}

function openPromptModal() { document.getElementById('promptModal').classList.add('open'); }
function closePromptModal() { document.getElementById('promptModal').classList.remove('open'); }
function copyPrompt() {
  navigator.clipboard.writeText(document.getElementById('aiStudioPromptText').textContent);
  const btn = document.getElementById('copyBtn');
  btn.textContent = '✅ Disalin!';
  setTimeout(() => btn.textContent = '📋 Salin Teks Prompt', 2000);
}

